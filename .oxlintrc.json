{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  "overrides": [
    {
      // Generated by the shadcn CLI. They export variant helpers alongside the
      // component by design, so the fast-refresh rule does not apply; every other
      // rule still does, because we do hand-edit some of these files.
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    },
    {
      // The icon set. Every export is a component, but each one is built by a
      // factory and the rule cannot see through it. Moving the factory to its own
      // file to satisfy it would put the lucide→Phosphor mapping somewhere other
      // than the comment that explains it.
      "files": ["src/lib/icons.tsx"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
